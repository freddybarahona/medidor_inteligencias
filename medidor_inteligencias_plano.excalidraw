    {
      "id": "6MITpipNlhSAQTOXPdv9F",
      "type": "text",
      "x": 7069.706423861165,
      "y": 4444.875958769979,
      "width": 472.13983154296875,
      "height": 45,
      "angle": 0,
      "strokeColor": "#292a2d",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
